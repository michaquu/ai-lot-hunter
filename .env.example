# Required: Google Gemini API Key (get one from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Telegram Bot Notification Settings
# Create a bot via @BotFather on Telegram to get TELEGRAM_BOT_TOKEN
# Get your chat ID via @userinfobot or https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional: Scraper runtime settings
HEADLESS=false
MAX_LISTINGS_PER_SOURCE=10
MAX_IMAGES_PER_LISTING=10
